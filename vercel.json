{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.blventerprisesllc.com"
        }
      ],
      "destination": "https://blventerprisesllc.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.blventerprisesllc.com"
        }
      ],
      "destination": "https://blventerprisesllc.com/:path*",
      "permanent": true
    }
  ]
}
